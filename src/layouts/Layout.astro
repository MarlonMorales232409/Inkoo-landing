// WebSite schema for sitelinks search
const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.inkoosub.com/#website",
  name: "Inkoo Sublimation",
  url: "https://www.inkoosub.com",
  description: "Estampación textil profesional para PYMEs, gimnasios y equipos deportivos en España. Sublimación y vinilo de alta gama.",
  publisher: { "@id": "https://www.inkoosub.com/#business" },
  inLanguage: "es",
};

// WebPage schema
const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonicalURL.href,
  url: canonicalURL.href,
  name: title,
  description,
  isPartOf: { "@id": "https://www.inkoosub.com/#website" },
  about: { "@id": "https://www.inkoosub.com/#business" },
  inLanguage: "es",
  dateModified: new Date().toISOString().split("T")[0],
};

// BreadcrumbList schema
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: "https://www.inkoosub.com",
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="estampación textil profesional, sublimación textil, camisetas personalizadas empresas, vinilo textil, uniformes sublimados, camisetas crossfit, uniformes hostelería, merchandising eventos, sublimación premium, impresión textil España, tiradas cortas camisetas, ropa personalizada negocios, sublimación profesional, proveedor sublimación, ropa deportiva sublimada, estampación camisetas, prendas personalizadas PYMEs"
    />
    <meta name="author" content="Inkoo Sublimation" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <!-- Language and Geo targeting -->
    <meta name="language" content="es" />
    <meta name="geo.region" content="ES" />
    <meta name="geo.placename" content="España" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Inkoo Sublimation - Estampación textil profesional para empresas y equipos deportivos" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Inkoo Sublimation" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Inkoo Sublimation - Estampación textil profesional para empresas y equipos deportivos" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg?v=2" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

    <!-- Global Styles -->
    <style>
      @import "../styles/global.css";
    </style>
  </head>
  <body
    class="bg-inkoo-black text-white font-sans antialiased selection:bg-inkoo-magenta selection:text-white overflow-x-hidden"
  >
    <slot />
    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";
      AOS.init({
        duration: 800,
        once: true,
        offset: 100,
      });
    </script>
  </body>
</html>
