---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, "https://www.inkoosub.com");

const {
  title = "Inkoo Sublimation | Estampación Profesional de Camisetas para Empresas y Equipos",
  description = "Estampación textil profesional para PYMEs, gimnasios y equipos deportivos. Packs desde 6 unidades con envío gratis. Sublimación y vinilo de alta resistencia. Presupuesto en 24h.",
  ogImage = "https://www.inkoosub.com/og-image.png",
} = Astro.props;

// Font Imports
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/800.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/900.css";

// JSON-LD Schema — LocalBusiness + ProfessionalService
const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": "https://www.inkoosub.com/#business",
  name: "Inkoo Sublimation",
  alternateName: "Inkoo Sub",
  url: "https://www.inkoosub.com",
  logo: {
    "@type": "ImageObject",
    url: "https://www.inkoosub.com/favicon.svg",
    width: 512,
    height: 512,
  },
  image: ogImage,
  description: "Estampación textil profesional para PYMEs, gimnasios y equipos deportivos en España. Sublimación y vinilo de alta gama en tiradas desde 6 unidades. Packs desde 9,90 EUR por prenda con envío gratis y asegurado.",
  telephone: "+34633272890",
  email: "inkoosub@gmail.com",
  priceRange: "$$",
  currenciesAccepted: "EUR",
  paymentAccepted: "Transferencia bancaria, Bizum",
  openingHours: "Mo-Fr 09:00-18:00",
  address: {
    "@type": "PostalAddress",
    addressCountry: "ES",
    addressRegion: "Cataluña",
  },
  areaServed: [
    {
      "@type": "Country",
      name: "España",
    },
    {
      "@type": "AdministrativeArea",
      name: "Unión Europea",
    },
  ],
  knowsAbout: [
    "Sublimación textil",
    "Impresión por sublimación",
    "Estampación textil profesional",
    "Camisetas personalizadas para empresas",
    "Uniformes sublimados",
    "Ropa deportiva personalizada",
    "Vinilo textil de alta gama",
    "Estampación térmica avanzada",
    "Personalización de prendas para PYMEs",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Packs de Estampación Textil Profesional",
    itemListElement: [
      {
        "@type": "Offer",
        name: "Pack 6-11 Unidades",
        description:
          "Estampación profesional para equipos pequeños y primeros pedidos. Incluye estampado resistente al uso diario, envío gratis y asegurado, y optimización de archivos.",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          priceCurrency: "EUR",
          price: "11.90",
          unitText: "por unidad",
          referenceQuantity: {
            "@type": "QuantitativeValue",
            minValue: 6,
            maxValue: 11,
            unitCode: "C62",
          },
        },
        itemOffered: {
          "@type": "Service",
          name: "Estampación textil por sublimación y vinilo",
          provider: { "@id": "https://www.inkoosub.com/#business" },
        },
      },
      {
        "@type": "Offer",
        name: "Pack 12-24 Unidades",
        description:
          "La opción más popular. Ideal para plantillas completas y clubes deportivos. Calidad premium para uso intensivo, envío gratis y asegurado, acabado consistente en todas las unidades.",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          priceCurrency: "EUR",
          price: "9.90",
          unitText: "por unidad",
          referenceQuantity: {
            "@type": "QuantitativeValue",
