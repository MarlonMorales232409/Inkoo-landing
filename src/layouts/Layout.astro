---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, "https://www.inkoosub.com");

const {
  title = "Inkoo Sublimation | Sublimación Textil Premium para Negocios — Envíos a toda España",
  description = "Especialistas en sublimación textil de 5 a 50 unidades para Boxes de Crossfit, empresas de reformas, hostelería y eventos. Calidad premium, entrega rápida y envíos a toda España.",
  ogImage = "https://www.inkoosub.com/og-image.png",
} = Astro.props;

// Font Imports
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/800.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/900.css";

// JSON-LD Schema — Service + LocalBusiness (envíos nacionales e internacionales)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ClothingStore"],
  "@id": "https://www.inkoosub.com/#business",
  name: "Inkoo Sublimation",
  alternateName: "Inkoo Sub",
  url: "https://www.inkoosub.com",
  logo: "https://www.inkoosub.com/favicon.svg",
  image: ogImage,
  description,
  telephone: "+34633272890",
  email: "inkoosub@gmail.com",
  priceRange: "€€",
  currenciesAccepted: "EUR",
  paymentAccepted: "Transferencia bancaria, Bizum",
  openingHours: "Mo-Fr 09:00-18:00",
  address: {
    "@type": "PostalAddress",
    addressCountry: "ES",
    addressRegion: "Cataluña",
  },
  // Área de servicio amplia: envíos nacionales e internacionales
  areaServed: [
    {
      "@type": "Country",
      name: "España",
    },
    {
      "@type": "AdministrativeArea",
      name: "Unión Europea",
    },
  ],
  // Públicos objetivo B2B
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de Sublimación Textil Premium",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Sublimación para Boxes de Crossfit y Gimnasios",
          description:
            "Camisetas técnicas personalizadas para boxes de Crossfit y gimnasios. Tiradas de 5 a 50 unidades, resistentes al sudor y lavados intensivos.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Uniformes de Empresa — Reformas, Construcción y Oficios",
          description:
            "Uniformes sublimados duraderos para equipos de construcción, reformas y oficios. Personalización completa con logotipos y diseños corporativos.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Camisetas para Hostelería Moderna",
          description:
            "Uniformes con diseño profesional para restaurantes, bares y locales de hostelería. Imagen de marca impecable con sublimación de alta definición.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Merchandising para Eventos y Festivales",
          description:
            "Camisetas y merchandising personalizado para eventos corporativos, deportivos y festivales. Producción rápida desde 5 unidades.",
        },
      },
    ],
  },
  // Información adicional SEO
  sameAs: ["https://www.instagram.com/inkoosub"],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    reviewCount: "12",
    bestRating: "5",
    worstRating: "1",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="sublimación textil, camisetas personalizadas, sublimación para empresas, uniformes sublimados, camisetas crossfit, uniformes hostelería, merchandising eventos, sublimación premium, impresión textil España, tiradas cortas camisetas, ropa personalizada negocios"
    />
    <meta name="author" content="Inkoo Sublimation" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Inkoo Sublimation" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg?v=2" />

    <!-- Preconnect para rendimiento -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Global Styles -->
    <style>
      @import "../styles/global.css";
    </style>
  </head>
  <body
    class="bg-inkoo-black text-white font-sans antialiased selection:bg-inkoo-magenta selection:text-white overflow-x-hidden"
  >
    <slot />
    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";
      AOS.init({
        duration: 800,
        once: true,
        offset: 100,
      });
    </script>
  </body>
</html>
