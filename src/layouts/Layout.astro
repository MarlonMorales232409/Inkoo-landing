        },
      },
      {
        "@type": "Offer",
        name: "Pack 25+ Unidades",
        description:
          "El mejor precio por unidad para empresas y eventos con equipos grandes. Prioridad en producción y entrega, envío gratis y asegurado.",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          priceCurrency: "EUR",
          price: "8.90",
          unitText: "por unidad",
          referenceQuantity: {
            "@type": "QuantitativeValue",
            minValue: 25,
            unitCode: "C62",
          },
        },
