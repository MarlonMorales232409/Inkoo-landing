---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/organisms/Navbar.astro";
import Hero from "../components/organisms/Hero.astro";
import ValueProposition from "../components/organisms/ValueProposition.astro";
import ContactForm from "../components/organisms/ContactForm.astro";
import Footer from "../components/organisms/Footer.astro";
import FloatingWhatsApp from "../components/organisms/FloatingWhatsApp.astro";
import RecentWork from "../components/sections/RecentWork.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import Pricing from "../components/sections/Pricing.astro";
import FAQ from "../components/sections/FAQ.astro";
import ScrollToTop from "../components/organisms/ScrollToTop.astro";
---

<Layout
  title="Inkoo Sublimation | Estampación Profesional de Camisetas para Empresas y Equipos"
  description="Estampación textil profesional para PYMEs, gimnasios y equipos deportivos. Packs desde 6 unidades con envío gratis. Sublimación y vinilo de alta resistencia. Presupuesto en 24h."
>
  <!-- Navigation -->
  <header>
    <Navbar />
  </header>

  <!-- Main Content -->
  <main>
    <!-- Hero Section -->
    <Hero />

    <!-- Value Proposition Section -->
    <ValueProposition />

    <!-- Recent Work / Portfolio Section -->
    <RecentWork />

    <!-- Process Steps Section -->
    <ProcessSteps />

    <!-- Pricing Section -->
    <Pricing />

    <!-- FAQ Section -->
    <FAQ />

    <!-- Contact Form Section -->
    <ContactForm />
  </main>

  <!-- Footer -->
  <Footer />

  <!-- Floating Buttons -->
  <aside
    aria-label="Acciones rápidas"
    class="fixed bottom-6 right-6 z-50 flex flex-col gap-y-5 items-center justify-center"
  >
    <ScrollToTop />
    <FloatingWhatsApp />
  </aside>
</Layout>
