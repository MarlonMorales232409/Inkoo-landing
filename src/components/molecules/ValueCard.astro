---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div
  class="group flex flex-col items-center text-center p-8 bg-white shadow-xl shadow-black/5 rounded-2xl border border-gray-100 hover:border-gray-200 hover:shadow-2xl hover:shadow-gray-200/50 transition-all duration-300 transform hover:-translate-y-1 h-full"
>
  <div
    class="w-16 h-16 mb-6 flex items-center justify-center bg-gray-50 rounded-full border border-gray-100 group-hover:border-inkoo-magenta/50 transition-all duration-300"
  >
    <svg
      class="w-8 h-8 text-inkoo-magenta transition-colors duration-300"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      {
        icon === "package-check" && (
          <g>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 16l2 2 4-4"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m7.5 4.27 9 5.15"
            />
            <polyline
              stroke-linecap="round"
              stroke-linejoin="round"
              points="3.29 7 12 12 20.71 7"
            />
            <line
              stroke-linecap="round"
              stroke-linejoin="round"
              x1="12"
              y1="22"
              x2="12"
              y2="12"
            />
          </g>
        )
      }
      {
        icon === "diamond" && (
          <g>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m9 12 2 2 4-4"
            />
          </g>
        )
      }
      {
        icon === "shield-truck" && (
          <g>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m9 12 2 2 4-4"
            />
          </g>
        )
      }
    </svg>
  </div>
  <h3
    class="text-2xl font-heading font-semibold text-inkoo-black mb-3 transition-colors duration-300"
  >
    {title}
  </h3>
  <p
    class="text-gray-600 text-base leading-relaxed group-hover:text-gray-700 transition-colors duration-300"
  >
    {description}
  </p>
</div>
