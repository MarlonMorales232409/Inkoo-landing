---
const pricingTiers = [
  {
    name: "Pack 6–11 Unidades",
    tagline:
      "Para equipos pequeños, primeros pedidos o cuando necesitas pocas unidades.",
    price: "14,90€",
    priceDetail: "Por unidad · De 6 a 11 unidades",
    features: [
      "Estampado resistente al uso diario",
      "Envío gratis y asegurado",
      "Optimización de archivos incluida",
    ],
    cta: "Pedir Presupuesto",
    href: "https://wa.me/34633272890?text=Hola%2C%20soy%20%5Bnombre%5D%20de%20%5Bempresa%2Fequipo%5D.%20Me%20interesa%20el%20Pack%20de%206%20unidades.%20Quiero%20presupuesto%20para%20%5Bcantidad%5D%20camisetas%20con%20nuestro%20logo.",
    highlighted: false,
  },
  {
    name: "Pack 12–24 Unidades",
    tagline:
      "Nuestra opción más popular. Ideal para plantillas completas y clubes deportivos.",
    price: "11,90€",
    priceDetail: "Por unidad · De 12 a 24 unidades",
    features: [
      "Calidad premium para uso intensivo",
      "Envío gratis y asegurado",
      "Acabado consistente en todas las unidades",
    ],
    cta: "Pedir Presupuesto",
    href: "https://wa.me/34633272890?text=Hola%2C%20soy%20%5Bnombre%5D%20de%20%5Bempresa%2Fequipo%5D.%20Necesito%20presupuesto%20para%2012%2B%20camisetas%20personalizadas%20con%20nuestro%20logo.",
    highlighted: true,
    badge: "Más Popular",
  },
  {
    name: "Pack 25+ Unidades",
    tagline:
      "El mejor precio por unidad para empresas y eventos con equipos grandes.",
    price: "9,90€",
    priceDetail: "Por unidad · Estampado",
    features: [
      "El precio más bajo por prenda",
      "Envío gratis y asegurado",
      "Prioridad en producción y entrega",
    ],
    cta: "Pedir Presupuesto",
    href: "https://wa.me/34633272890?text=Hola%2C%20soy%20%5Bnombre%5D%20de%20%5Bempresa%2Fequipo%5D.%20Necesito%20presupuesto%20para%2025%2B%20camisetas%20personalizadas%20con%20nuestro%20logo.",
    highlighted: false,
  },
];
---

<section
  id="precios"
  class="py-20 lg:py-32 relative overflow-hidden bg-gradient-to-b from-gray-50 to-white"
>
  <!-- Background Elements -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Glows -->
    <div
      class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-inkoo-magenta/5 blur-[120px] rounded-full mix-blend-multiply"
    >
    </div>
    <div
      class="absolute bottom-0 left-1/4 w-[600px] h-[600px] bg-inkoo-cyan/5 blur-[120px] rounded-full mix-blend-multiply"
    >
    </div>

    <!-- Sparkles -->
    <svg
      class="absolute top-24 right-[15%] w-6 h-6 text-inkoo-magenta/30 animate-pulse"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"
      ></path>
    </svg>
    <svg
      class="absolute bottom-32 left-[10%] w-8 h-8 text-inkoo-cyan/40 animate-pulse delay-500"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"
      ></path>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <h2
        class="text-4xl sm:text-5xl lg:text-6xl font-heading font-medium text-inkoo-black mb-6"
      >
        Precios <span class="text-inkoo-magenta">Transparentes</span>
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Sin letra pequeña. Precio del estampado por prenda &mdash; la prenda se presupuesta aparte según modelo y talla.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {
        pricingTiers.map((tier, index) => (
          <div
            class={`relative group ${tier.highlighted ? "md:-mt-4" : ""}`}
            data-aos="fade-up"
            data-aos-delay={index * 150}
          >
            {/* Popular Badge */}
            {tier.badge && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-20">
                <span class="bg-gradient-to-r from-inkoo-magenta to-pink-600 text-white text-sm font-semibold px-4 py-1.5 rounded-full shadow-lg">
                  {tier.badge}
                </span>
              </div>
            )}

            {/* Card */}
            <div
              class={`relative h-full bg-white rounded-2xl overflow-hidden transition-all duration-300 ${
                tier.highlighted
                  ? "border-2 border-inkoo-magenta shadow-2xl shadow-inkoo-magenta/20 md:scale-105"
                  : "border border-gray-200 shadow-lg hover:shadow-xl hover:border-inkoo-magenta/50"
              }`}
            >
              {/* Highlighted glow */}
              {tier.highlighted && (
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-inkoo-magenta via-pink-500 to-inkoo-magenta" />
              )}

              <div class="p-8">
                {/* Tier Name */}
                <h3 class="text-2xl font-heading font-semibold text-inkoo-black mb-2">
                  {tier.name}
                </h3>

                {/* Tagline */}
                <p class="text-gray-600 text-sm mb-6 min-h-[40px]">
                  {tier.tagline}
                </p>

                {/* Price */}
                <div class="mb-8">
                  <div class="flex items-baseline gap-2">
                    <span
                      class={`text-5xl font-heading font-bold ${
                        tier.highlighted
                          ? "text-inkoo-magenta"
                          : "text-inkoo-black"
                      }`}
                    >
                      {tier.price}
                    </span>
                  </div>
                  <p class="text-gray-500 text-sm mt-1">{tier.priceDetail}</p>
                </div>

                {/* Features */}
                <ul class="space-y-4 mb-8">
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class={`w-5 h-5 flex-shrink-0 mt-0.5 ${
                          tier.highlighted
                            ? "text-inkoo-magenta"
                            : "text-inkoo-cyan"
                        }`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span class="text-gray-700 text-sm leading-relaxed">
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>

                {/* CTA Button */}
                {tier.href ? (
                  <a
                    href={tier.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`block w-full text-center py-3.5 px-6 rounded-full font-semibold transition-all duration-300 ${
                      tier.highlighted
                        ? "bg-inkoo-magenta text-white hover:bg-pink-600 shadow-lg shadow-inkoo-magenta/30 hover:shadow-xl hover:shadow-inkoo-magenta/40 hover:-translate-y-0.5"
                        : "bg-transparent border-2 border-inkoo-cyan text-inkoo-cyan hover:bg-inkoo-cyan hover:text-white shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    }`}
                  >
                    {tier.cta}
                  </a>
                ) : (
                  <button
                    class={`w-full py-3.5 px-6 rounded-full font-semibold transition-all duration-300 ${
                      tier.highlighted
                        ? "bg-inkoo-magenta text-white hover:bg-pink-600 shadow-lg shadow-inkoo-magenta/30 hover:shadow-xl hover:shadow-inkoo-magenta/40 hover:-translate-y-0.5"
                        : "bg-transparent border-2 border-inkoo-cyan text-inkoo-cyan hover:bg-inkoo-cyan hover:text-white shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    }`}
                  >
                    {tier.cta}
                  </button>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Sample CTA -->
    <div class="text-center mt-12" data-aos="fade-up" data-aos-delay="500">
      <p class="text-gray-600 text-base">
        ¿Prefieres probar primero? <a
          href="https://wa.me/34633272890?text=Hola%2C%20soy%20%5Bnombre%5D%20de%20%5Bempresa%5D.%20Me%20gustar%C3%ADa%20pedir%20una%20muestra%20de%20calidad%20(19%E2%82%AC)%20antes%20de%20hacer%20mi%20pedido."
          target="_blank"
          rel="noopener noreferrer"
          class="text-inkoo-cyan font-semibold underline underline-offset-2 hover:text-inkoo-magenta transition-colors"
        >Pide una muestra por 19€</a> — 1 prenda con tu logo estampado.
      </p>
    </div>

    <!-- Trust Note -->
    <div class="text-center mt-6" data-aos="fade-up" data-aos-delay="600">
      <p class="text-gray-500 text-sm">
        ¿También necesitas tazas personalizadas? <a
          href="https://wa.me/34633272890?text=Hola%2C%20me%20interesa%20presupuesto%20para%20tazas%20personalizadas%20con%20nuestro%20logo."
          target="_blank"
          rel="noopener noreferrer"
          class="text-inkoo-cyan font-semibold underline underline-offset-2 hover:text-inkoo-magenta transition-colors"
        >Consúltanos por WhatsApp</a>
        <br><span class="text-gray-500 text-sm">Presupuesto cerrado en 24h &middot; Sin costes ocultos &middot; Pago por transferencia o Bizum</span>
      </p>
    </div>
  </div>
</section>
