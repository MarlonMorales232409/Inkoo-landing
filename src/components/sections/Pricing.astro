---
const pricingTiers = [
  {
    name: "Pack Esencial",
    tagline:
      "La solución profesional para autónomos, parejas o pequeños equipos que no necesitan stock.",
    price: "14,75€",
    priceDetail: "Por prenda · De 3 a 5 unidades",
    features: [
      "Estampado de alta resistencia",
      "Envío gratis y asegurado",
      "Optimización de archivos",
    ],
    cta: "Pedir Presupuesto",
    href: "https://wa.me/34633272890?text=%C2%A1Hola!%20Me%20interesa%20el%20Pack%20Esencial%20(desde%2014%2C75%E2%82%AC%2Fprenda).%20Somos%20un%20grupo%20peque%C3%B1o%20de%20entre%203%20y%205%20personas",
    highlighted: false,
  },
  {
    name: "Pack Team & Eventos",
    tagline:
      "Nuestra mejor opción para equipar a toda la plantilla, clubes deportivos, peñas y eventos (despedidas/fiestas).",
    price: "9,90€",
    priceDetail: "Por unidad · A partir de 6 unidades",
    features: [
      "Calidad premium duradera",
      "Envío gratis y asegurado",
      "Ideal para uso diario e intensivo",
    ],
    cta: "Pedir Presupuesto",
    href: "https://wa.me/34633272890?text=%C2%A1Hola%2C%20equipo%20Inkoo!%20Querr%C3%ADa%20informaci%C3%B3n%20sobre%20el%20Pack%20Team%20%26%20Eventos%20(desde%209%2C90%E2%82%AC%2Funidad).%20Somos%20un%20grupo%20de%20m%C3%A1s%20de%206%20personas",
    highlighted: true,
    badge: "Mejor Valor",
  },
  {
    name: "Muestra de Calidad",
    tagline:
      "Valida materiales y acabados con una prenda física. 10€ de descuento al contratar tu Pack Team & Eventos (6+ unidades).",
    price: "19€",
    priceDetail: "Válido para pedidos de 6+ unidades",
    features: [
      "1 Prenda premium con tu diseño",
      "Asesoramiento técnico incluido",
      "10€ de descuento en tu pedido grupal (6+ uds)",
    ],
    cta: "Pedir Muestra",
    href: "https://wa.me/34633272890?text=%C2%A1Hola%2C%20Inkoo!%20%F0%9F%91%8B%20Me%20gustar%C3%ADa%20pedir%20una%20Muestra%20de%20Calidad%20(19%E2%82%AC)%20para%20validar%20materiales%20y%20acabados%20con%20mi%20dise%C3%B1o%20antes%20de%20lanzar%20mi%20pedido%20grupal",
    highlighted: false,
  },
];
---

<section
  id="precios"
  class="py-20 lg:py-32 relative overflow-hidden bg-gradient-to-b from-gray-50 to-white"
>
  <!-- Background Elements -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Glows -->
    <div
      class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-inkoo-magenta/5 blur-[120px] rounded-full mix-blend-multiply"
    >
    </div>
    <div
      class="absolute bottom-0 left-1/4 w-[600px] h-[600px] bg-inkoo-cyan/5 blur-[120px] rounded-full mix-blend-multiply"
    >
    </div>

    <!-- Sparkles -->
    <svg
      class="absolute top-24 right-[15%] w-6 h-6 text-inkoo-magenta/30 animate-pulse"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"
      ></path>
    </svg>
    <svg
      class="absolute bottom-32 left-[10%] w-8 h-8 text-inkoo-cyan/40 animate-pulse delay-500"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"
      ></path>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <h2
        class="text-4xl sm:text-5xl lg:text-6xl font-heading font-medium text-inkoo-black mb-6"
      >
        Precios <span class="text-inkoo-magenta">Transparentes</span>
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Sin letra pequeña. Elige el pack que mejor se adapte a tu negocio.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {
        pricingTiers.map((tier, index) => (
          <div
            class={`relative group ${tier.highlighted ? "md:-mt-4" : ""}`}
            data-aos="fade-up"
            data-aos-delay={index * 150}
          >
            {/* Popular Badge */}
            {tier.badge && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-20">
                <span class="bg-gradient-to-r from-inkoo-magenta to-pink-600 text-white text-sm font-semibold px-4 py-1.5 rounded-full shadow-lg">
                  {tier.badge}
                </span>
              </div>
            )}

            {/* Card */}
            <div
              class={`relative h-full bg-white rounded-2xl overflow-hidden transition-all duration-300 ${
                tier.highlighted
                  ? "border-2 border-inkoo-magenta shadow-2xl shadow-inkoo-magenta/20 md:scale-105"
                  : "border border-gray-200 shadow-lg hover:shadow-xl hover:border-inkoo-magenta/50"
              }`}
            >
              {/* Highlighted glow */}
              {tier.highlighted && (
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-inkoo-magenta via-pink-500 to-inkoo-magenta" />
              )}

              <div class="p-8">
                {/* Tier Name */}
                <h3 class="text-2xl font-heading font-semibold text-inkoo-black mb-2">
                  {tier.name}
                </h3>

                {/* Tagline */}
                <p class="text-gray-600 text-sm mb-6 min-h-[40px]">
                  {tier.tagline}
                </p>

                {/* Price */}
                <div class="mb-8">
                  <div class="flex items-baseline gap-2">
                    <span
                      class={`text-5xl font-heading font-bold ${
                        tier.highlighted
                          ? "text-inkoo-magenta"
                          : "text-inkoo-black"
                      }`}
                    >
                      {tier.price}
                    </span>
                  </div>
                  <p class="text-gray-500 text-sm mt-1">{tier.priceDetail}</p>
                </div>

                {/* Features */}
                <ul class="space-y-4 mb-8">
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class={`w-5 h-5 flex-shrink-0 mt-0.5 ${
                          tier.highlighted
                            ? "text-inkoo-magenta"
                            : "text-inkoo-cyan"
                        }`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span class="text-gray-700 text-sm leading-relaxed">
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>

                {/* CTA Button */}
                {tier.href ? (
                  <a
                    href={tier.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`block w-full text-center py-3.5 px-6 rounded-full font-semibold transition-all duration-300 ${
                      tier.highlighted
                        ? "bg-inkoo-magenta text-white hover:bg-pink-600 shadow-lg shadow-inkoo-magenta/30 hover:shadow-xl hover:shadow-inkoo-magenta/40 hover:-translate-y-0.5"
                        : "bg-transparent border-2 border-inkoo-cyan text-inkoo-cyan hover:bg-inkoo-cyan hover:text-white shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    }`}
                  >
                    {tier.cta}
                  </a>
                ) : (
                  <button
                    class={`w-full py-3.5 px-6 rounded-full font-semibold transition-all duration-300 ${
                      tier.highlighted
                        ? "bg-inkoo-magenta text-white hover:bg-pink-600 shadow-lg shadow-inkoo-magenta/30 hover:shadow-xl hover:shadow-inkoo-magenta/40 hover:-translate-y-0.5"
                        : "bg-transparent border-2 border-inkoo-cyan text-inkoo-cyan hover:bg-inkoo-cyan hover:text-white shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    }`}
                  >
                    {tier.cta}
                  </button>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Trust Note -->
    <div class="text-center mt-12" data-aos="fade-up" data-aos-delay="600">
      <p class="text-gray-500 text-sm">
        ✓ Sin costes ocultos · ✓ Presupuesto en 24h · ✓ Pago seguro
      </p>
    </div>
  </div>
</section>
