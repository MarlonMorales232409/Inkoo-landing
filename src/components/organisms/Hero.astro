---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/hero-press.png";
import Button from "../atoms/Button.astro";
---

<section
  class="relative pt-[12vh] pb-20 sm:pt-[14vh] sm:pb-24 lg:pt-[16vh] lg:pb-32 overflow-hidden min-h-screen flex items-start"
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImage}
      alt="Industrial Heat Press"
      class="w-full h-full object-cover"
      quality="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/70 to-black/40"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-3xl">
      <!-- Kicker -->
      <p
        class="text-inkoo-cyan text-sm sm:text-base font-semibold uppercase tracking-widest mb-5"
        data-aos="fade-up"
      >
        Taller de estampación textil profesional
      </p>

      <!-- Headline -->
      <h1
        class="font-heading font-medium text-4xl sm:text-5xl lg:text-6xl leading-tight sm:leading-snug mb-6 text-white tracking-tight"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Personalización textil <span class="text-inkoo-magenta font-bold"
          >premium</span
        >. <br />
        Sin mínimos imposibles.
      </h1>

      <!-- Subheadline -->
      <p
        class="text-lg sm:text-xl text-gray-300 mb-0 leading-loose max-w-xl drop-shadow-md"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        Estampamos de 5 a 50 unidades para negocios, clubes y eventos. Calidad
        profesional sin complicaciones.
      </p>

      <!-- Primary CTA -->
      <div
        class="flex flex-col sm:flex-row gap-5 mt-12"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <Button variant="primary" size="large" href="#precios">
          Ver Planes y Precios
        </Button>
        <Button
          variant="secondary"
          size="large"
          href="https://wa.me/34633272890"
          class="backdrop-blur-md bg-white/10 hover:bg-white/20 border border-white/20"
        >
          Hablamos por WhatsApp
        </Button>
      </div>
    </div>
  </div>
</section>
