---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/hero-press.png";
import Button from "../atoms/Button.astro";
---

<section
  class="relative pt-[12vh] pb-20 sm:pt-[14vh] sm:pb-24 lg:pt-[16vh] lg:pb-32 overflow-hidden min-h-screen flex items-start"
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImage}
      alt="Prensa de calor industrial para sublimación textil profesional de camisetas personalizadas"
      class="w-full h-full object-cover"
      quality="high"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/80 to-black/50"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-3xl">
      <!-- Kicker -->
      <p
        class="text-inkoo-cyan text-sm sm:text-base font-semibold uppercase tracking-widest mb-5"
        data-aos="fade-up"
      >
        Estampación profesional para empresas y equipos
      </p>

      <!-- Headline -->
      <h1
        class="font-heading font-medium text-4xl sm:text-5xl lg:text-6xl leading-tight sm:leading-snug mb-6 text-white tracking-tight"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        La imagen de tu empresa, <span class="text-inkoo-magenta font-bold"
          >estampada con calidad</span
        > profesional
      </h1>

      <!-- Subheadline - Lista de beneficios B2B -->
      <ul
        class="text-lg sm:text-xl text-gray-300 mb-0 leading-loose max-w-xl drop-shadow-md space-y-2"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <li>&#10003; Packs desde 6 unidades para tu equipo</li>
        <li>&#10003; Logo en pecho, espalda o manga</li>
        <li>&#10003; Producción en 3-5 días hábiles</li>
        <li>&#10003; Presupuesto en minutos por WhatsApp</li>
      </ul>

      <!-- CTAs -->
      <div
        class="flex flex-col sm:flex-row gap-5 mt-12"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <Button
          variant="primary"
          size="large"
          href="https://wa.me/34633272890?text=Hola%2C%20soy%20%5Bnombre%5D%20de%20%5Bempresa%2Fequipo%5D.%20Me%20interesa%20un%20presupuesto%20para%20personalizar%20camisetas%20para%20mi%20equipo."
          target="_blank"
          rel="noopener noreferrer"
        >
          Pedir presupuesto por WhatsApp
        </Button>
        <Button
          variant="secondary"
          size="large"
          href="#precios"
          class="backdrop-blur-md bg-white/10 hover:bg-white/20 border border-white/20"
        >
          Ver precios
        </Button>
      </div>

      <!-- Trust Badges -->
      <div
        class="flex flex-wrap gap-x-6 gap-y-2 mt-8 text-sm text-white/70"
        data-aos="fade-up"
        data-aos-delay="500"
      >
        <span>&#10003; Mockup gratuito antes de producir</span>
        <span>&#10003; Envío gratis y asegurado</span>
        <span>&#10003; Asesoramiento técnico incluido</span>
      </div>
    </div>
  </div>
</section>
