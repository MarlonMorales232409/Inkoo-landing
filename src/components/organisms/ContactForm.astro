---
import Button from "../atoms/Button.astro";
---

<section id="contacto" class="py-16 lg:pt-20 lg:pb-52 relative overflow-hidden">
  <!-- Light Background -->
  <div class="absolute inset-0 bg-white"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-8" data-aos="fade-up">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-heading font-medium text-inkoo-black mb-3"
      >
        Solicita tu <span class="text-inkoo-magenta">presupuesto</span>
      </h2>
      <p class="text-gray-600 text-base mb-6">
        La forma más rápida de pedir presupuesto es por WhatsApp. Si lo prefieres, usa el formulario.
      </p>

      <!-- Primary WhatsApp CTA -->
      <a
        href="https://wa.me/34633272890?text=Hola%2C%20soy%20%5Bnombre%5D%20de%20%5Bempresa%2Fequipo%5D.%20Necesito%20presupuesto%20para%20%5Bcantidad%5D%20camisetas%20personalizadas%20con%20nuestro%20logo."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#25D366] text-white font-semibold text-lg rounded-full hover:bg-[#20bd5a] transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
        </svg>
        Pedir presupuesto
      </a>

      <!-- Divider -->
      <div class="flex items-center gap-4 my-8 max-w-md mx-auto" data-aos="fade-up" data-aos-delay="150">
        <div class="flex-1 h-px bg-gray-300"></div>
        <span class="text-gray-400 text-sm">o usa el formulario</span>
        <div class="flex-1 h-px bg-gray-300"></div>
      </div>
    </div>

    <!-- Contact Form Card -->
    <div
      class="relative rounded-2xl overflow-hidden"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <!-- Subtle glow behind card -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-inkoo-magenta/5 blur-[80px] rounded-full pointer-events-none"
      >
      </div>

      <form
        id="contact-form"
        enctype="multipart/form-data"
        class="relative bg-gray-50 p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-lg"
      >
        <div class="grid gap-5">
          <!-- Row 1: Nombre y Empresa -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="nombre"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Nombre <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="nombre"
                id="nombre"
                placeholder="Juan Pérez"
                required
                class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-inkoo-black placeholder-gray-400 focus:outline-none focus:border-inkoo-magenta focus:ring-1 focus:ring-inkoo-magenta transition-colors"
              />
            </div>
            <div>
              <label
                for="empresa"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Empresa / Equipo <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="empresa"
                id="empresa"
                placeholder="Tu empresa o negocio"
                required
                class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-inkoo-black placeholder-gray-400 focus:outline-none focus:border-inkoo-magenta focus:ring-1 focus:ring-inkoo-magenta transition-colors"
              />
            </div>
          </div>

          <!-- Row 2: Método de contacto + Input dinámico -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Método de contacto <span class="text-red-500">*</span>
              </label>
              <input type="hidden" name="metodo_contacto" id="metodo-contacto" value="email" />
              <div class="relative" id="custom-select">
                <button
                  type="button"
                  id="select-trigger"
                  class="w-full flex items-center justify-between px-4 py-3 bg-white border border-gray-300 rounded-lg text-inkoo-black focus:outline-none focus:border-inkoo-magenta focus:ring-1 focus:ring-inkoo-magenta transition-colors cursor-pointer"
                >
                  <span id="select-value" class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    Email
                  </span>
                  <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" id="select-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div id="select-dropdown" class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden">
                  <div class="select-option flex items-center gap-2 px-4 py-3 cursor-pointer text-gray-700 hover:bg-inkoo-magenta/5 transition-colors" data-value="email">
                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span class="text-gray-700">Email</span>
                  </div>
                  <div class="select-option flex items-center gap-2 px-4 py-3 cursor-pointer text-gray-700 hover:bg-inkoo-magenta/5 transition-colors" data-value="whatsapp">
                    <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    <span class="text-gray-700">WhatsApp</span>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <label
                id="contacto-label"
                for="contacto-dato"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Tu Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                name="contacto_dato"
                id="contacto-dato"
                placeholder="tu@email.com"
                required
                class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-inkoo-black placeholder-gray-400 focus:outline-none focus:border-inkoo-magenta focus:ring-1 focus:ring-inkoo-magenta transition-colors"
              />
            </div>
          </div>

          <!-- Row 3: Mensaje -->
          <div>
            <label
              for="mensaje"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Mensaje <span class="text-red-500">*</span>
            </label>
            <textarea
              name="mensaje"
              id="mensaje"
              placeholder="Ej: Necesito 15 camisetas con nuestro logo para el equipo..."
              required
              rows="4"
              class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-inkoo-black placeholder-gray-400 focus:outline-none focus:border-inkoo-magenta focus:ring-1 focus:ring-inkoo-magenta transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Row 4: Adjuntar imágenes -->
          <div>
            <label
              for="adjuntos"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Adjuntar imágenes (opcional)
            </label>
            <div class="relative">
              <input
                type="file"
                name="adjuntos"
                id="adjuntos"
                accept="image/*"
                multiple
                class="hidden"
              />
              <div class="flex gap-2">
                <label
                  for="adjuntos"
                  class="flex-1 flex items-center justify-center gap-3 px-4 py-3 bg-white border border-dashed border-gray-300 rounded-lg text-gray-500 hover:text-inkoo-magenta hover:border-inkoo-magenta transition-colors cursor-pointer"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"
                    ></path>
                  </svg>
                  <span id="file-label">Haz clic para subir imágenes</span>
                </label>
                <button
                  type="button"
                  id="clear-files-btn"
                  class="hidden px-3 py-3 bg-red-500/20 border border-red-500/30 rounded-lg text-red-400 hover:bg-red-500/30 hover:text-red-300 transition-colors"
                  title="Eliminar archivos"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    ></path>
                  </svg>
                </button>
              </div>
              <p class="text-xs text-gray-400 mt-1.5">Tu logo, diseños o imágenes de referencia</p>
            </div>
          </div>
        </div>

        <div class="mt-6">
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-inkoo-magenta text-white py-4 px-8 rounded-full font-semibold text-lg hover:bg-pink-600 transition-all duration-300 shadow-lg shadow-inkoo-magenta/30 hover:shadow-xl hover:shadow-inkoo-magenta/40 hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0"
          >
            <span id="btn-text">Enviar solicitud</span>
            <span id="btn-spinner" class="hidden">
              <svg
                class="animate-spin h-5 w-5 mx-auto text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </span>
          </button>
        </div>

        <!-- Error message -->
        <div
          id="form-error"
          class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-center"
        >
          <p class="text-red-700 font-medium" id="error-text">
            Hubo un error al enviar. Inténtalo de nuevo.
          </p>
        </div>
      </form>

      <script>
        // Handle custom dropdown
        const hiddenInput = document.getElementById("metodo-contacto") as HTMLInputElement;
        const selectTrigger = document.getElementById("select-trigger");
        const selectDropdown = document.getElementById("select-dropdown");
        const selectValue = document.getElementById("select-value");
        const selectArrow = document.getElementById("select-arrow");
        const selectOptions = document.querySelectorAll(".select-option");
        const contactoInput = document.getElementById("contacto-dato") as HTMLInputElement;
        const contactoLabel = document.getElementById("contacto-label");

        const icons: Record<string, string> = {
          email: '<svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>',
          whatsapp: '<svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>',
        };

        selectTrigger?.addEventListener("click", () => {
          selectDropdown?.classList.toggle("hidden");
          selectArrow?.classList.toggle("rotate-180");
        });

        document.addEventListener("click", (e) => {
          if (!(e.target as Element).closest("#custom-select")) {
            selectDropdown?.classList.add("hidden");
            selectArrow?.classList.remove("rotate-180");
          }
        });

        selectOptions.forEach((option) => {
          option.addEventListener("click", () => {
            const value = (option as HTMLElement).dataset.value || "email";
            const label = value === "email" ? "Email" : "WhatsApp";

            if (hiddenInput) hiddenInput.value = value;
            if (selectValue) selectValue.innerHTML = `${icons[value]} ${label}`;
            selectDropdown?.classList.add("hidden");
            selectArrow?.classList.remove("rotate-180");

            if (value === "email") {
              if (contactoInput) { contactoInput.type = "email"; contactoInput.placeholder = "tu@email.com"; }
              if (contactoLabel) contactoLabel.innerHTML = 'Tu Email <span class="text-red-500">*</span>';
            } else {
              if (contactoInput) { contactoInput.type = "tel"; contactoInput.placeholder = "+34 600 000 000"; }
              if (contactoLabel) contactoLabel.innerHTML = 'Tu WhatsApp <span class="text-red-500">*</span>';
            }
          });
        });

        // Handle file input label update
        const fileInput = document.getElementById(
          "adjuntos",
        ) as HTMLInputElement;
        const fileLabel = document.getElementById("file-label");
        const clearFilesBtn = document.getElementById("clear-files-btn");

        function updateFileUI() {
          if (fileInput.files && fileInput.files.length > 0) {
            const count = fileInput.files.length;
            if (fileLabel) {
              fileLabel.textContent =
                count === 1
                  ? fileInput.files[0].name
                  : `${count} archivos seleccionados`;
            }
            clearFilesBtn?.classList.remove("hidden");
          } else {
            if (fileLabel)
              fileLabel.textContent = "Haz clic para subir imágenes";
            clearFilesBtn?.classList.add("hidden");
          }
        }

        fileInput?.addEventListener("change", updateFileUI);

        clearFilesBtn?.addEventListener("click", () => {
          if (fileInput) {
            fileInput.value = "";
            updateFileUI();
          }
        });

        // Modal logic
        const successModal = document.getElementById("success-modal");
        const modalOverlay = document.getElementById("modal-overlay");
        const modalCard = document.getElementById("modal-card");
        const modalCloseBtn = document.getElementById("modal-close-btn");

        function openModal() {
          successModal?.classList.remove("hidden");
          // Trigger animation on next frame
          requestAnimationFrame(() => {
            modalCard?.classList.remove("scale-90", "opacity-0");
            modalCard?.classList.add("scale-100", "opacity-100");
          });
        }

        function closeModal() {
          modalCard?.classList.remove("scale-100", "opacity-100");
          modalCard?.classList.add("scale-90", "opacity-0");
          setTimeout(() => {
            successModal?.classList.add("hidden");
          }, 300);
        }

        modalCloseBtn?.addEventListener("click", closeModal);
        modalOverlay?.addEventListener("click", closeModal);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !successModal?.classList.contains("hidden")) {
            closeModal();
          }
        });

        // Handle form submission
        const form = document.getElementById("contact-form") as HTMLFormElement;
        const submitBtn = document.getElementById(
          "submit-btn",
        ) as HTMLButtonElement;
        const btnText = document.getElementById("btn-text");
        const btnSpinner = document.getElementById("btn-spinner");
        const errorMsg = document.getElementById("form-error");
        const errorText = document.getElementById("error-text");

        form?.addEventListener("submit", async (e) => {
          e.preventDefault();

          // Reset messages
          errorMsg?.classList.add("hidden");

          // Show loading state
          if (submitBtn) submitBtn.disabled = true;
          btnText?.classList.add("hidden");
          btnSpinner?.classList.remove("hidden");

          try {
            const formData = new FormData(form);

            const response = await fetch("/api/send", {
              method: "POST",
              body: formData,
            });

            const result = await response.json();

            if (response.ok && result.success) {
              // Success — show modal
              form.reset();
              updateFileUI();
              openModal();
            } else {
              // Server error
              if (errorText)
                errorText.textContent = result.error || "Error al enviar. Inténtalo de nuevo.";
              errorMsg?.classList.remove("hidden");
            }
          } catch (err) {
            // Network error
            if (errorText)
              errorText.textContent =
                "Error de conexión. Comprueba tu internet e inténtalo de nuevo.";
            errorMsg?.classList.remove("hidden");
          } finally {
            // Reset button
            if (submitBtn) submitBtn.disabled = false;
            btnText?.classList.remove("hidden");
            btnSpinner?.classList.add("hidden");
          }
        });
      </script>
    </div>
  </div>
</section>

<!-- Success Modal (outside section so fixed overlay covers full viewport) -->
<div
  id="success-modal"
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
>
  <!-- Overlay -->
  <div
    id="modal-overlay"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
  ></div>

  <!-- Modal Card -->
  <div
    id="modal-card"
    class="relative bg-white rounded-2xl p-8 sm:p-10 max-w-md w-full text-center shadow-2xl scale-90 opacity-0 transition-all duration-300"
  >
    <!-- Check Icon -->
    <div class="mx-auto mb-6 w-20 h-20 rounded-full bg-gradient-to-br from-inkoo-magenta to-pink-600 flex items-center justify-center shadow-lg shadow-inkoo-magenta/30">
      <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>

    <!-- Title -->
    <h3 class="text-2xl sm:text-3xl font-heading font-semibold text-inkoo-black mb-3">
      ¡Solicitud enviada!
    </h3>

    <!-- Description -->
    <p class="text-gray-600 mb-8">
      Nos pondremos en contacto contigo pronto para ofrecerte una solución personalizada.
