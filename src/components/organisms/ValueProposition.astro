---
import ValueCard from "../molecules/ValueCard.astro";
---

<section id="ventajas" class="py-20 lg:py-32 relative bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <h2
        class="text-4xl sm:text-5xl lg:text-6xl font-heading font-medium text-inkoo-black mb-6"
      >
        ¿Por qué <span class="text-inkoo-magenta">Inkoo</span> para tu empresa?
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Un proveedor fiable de estampación que entiende las necesidades de
        PYMEs, gimnasios y equipos deportivos.
      </p>
    </div>

    <!-- Value Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <div data-aos="fade-up" data-aos-delay="0">
        <ValueCard
          icon="package-check"
          title="Tiradas cortas, sin excesos"
          description="Desde 6 unidades. Equipa a tu plantilla o equipo sin acumular stock innecesario. Ideal para PYMEs, gimnasios y clubes que necesitan cantidades justas."
        />
      </div>
      <div data-aos="fade-up" data-aos-delay="200">
        <ValueCard
          icon="diamond"
          title="Calidad que representa a tu marca"
          description="Estampados resistentes al uso intensivo y lavados frecuentes. Tus empleados y deportistas lucirán una imagen profesional que no se degrada con el tiempo."
        />
      </div>
      <div data-aos="fade-up" data-aos-delay="400">
        <ValueCard
          icon="shield-truck"
          title="Envío gratis y sin sorpresas"
          description="El precio que te damos es el precio final. Envío gratuito, asegurado y con seguimiento. Tu pedido llega a tu negocio sin ningún coste adicional."
        />
      </div>
    </div>
  </div>
</section>
