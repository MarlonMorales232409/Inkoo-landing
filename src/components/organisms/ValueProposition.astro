---
import ValueCard from "../molecules/ValueCard.astro";
---

<section id="ventajas" class="py-20 lg:py-32 relative bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <h2
        class="text-4xl sm:text-5xl lg:text-6xl font-heading font-medium text-inkoo-black mb-6"
      >
        ¿Por qué elegir <span class="text-inkoo-magenta">Inkoo</span>?
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Transparencia, calidad y un servicio pensado para que solo te preocupes
        de elegir el diseño.
      </p>
    </div>

    <!-- Value Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <div data-aos="fade-up" data-aos-delay="0">
        <ValueCard
          icon="package-check"
          title="Pide solo lo que necesites"
          description="Olvídate de acumular stock innecesario. Personalizamos desde 5 unidades para que inviertas solo en lo que tu negocio o grupo realmente utiliza."
        />
      </div>
      <div data-aos="fade-up" data-aos-delay="200">
        <ValueCard
          icon="diamond"
          title="Acabado Profesional"
          description="Estampados de alta resistencia que no se cuartean ni pierden color. Garantizamos un acabado nítido y duradero que soporta el uso diario."
        />
      </div>
      <div data-aos="fade-up" data-aos-delay="400">
        <ValueCard
          icon="shield-truck"
          title="Envío Gratis y Asegurado"
          description="Sin sorpresas ni costes ocultos al finalizar tu pedido. Gestionamos el envío sin cargo adicional y realizamos el seguimiento para garantizar que todo llegue impecable."
        />
      </div>
    </div>
  </div>
</section>
